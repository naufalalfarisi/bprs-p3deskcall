datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String         @id @default(uuid())
  username                String         @unique
  passwordHash            String
  nama                    String
  email                   String
  tglLahir                DateTime
  posisi                  String         // admin, kabid_p3, staff_p3, desk_call, legal, ao, kabid_ao
  aoNameRef               String?
  status                  String         // pending, active, rejected, inactive
  emailVerified           Boolean        @default(false)
  roleConfirmed           Boolean        @default(false)
  confirmedBy             String?
  confirmedAt             DateTime?
  avatarUrl               String?
  registerAttemptCount    Int            @default(0)
  lastRegisterAttemptAt   DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  refreshTokens           RefreshToken[]
  deskCalls               DeskCall[]
  jadwalPenagihan        JadwalPenagihan[]
  penagihanFoto           PenagihanFoto[]
  legalBerkasChecklist   LegalBerkasChecklist[]
  legalFiles              LegalFile[]
  auditLogs               AuditLog[]
  aoDebiturs              Debitur[]              @relation("AoDebiturRelation")
  aoCollectionLogs        AoCollectionLog[]
  createdAoLogs           AoCollectionLog[]      @relation("CreatedByAoLog")
  aoReminderEmailLogs     AoReminderEmailLog[]
}

model EmailOtp {
  id          String   @id @default(uuid())
  email       String
  otpCode     String
  purpose     String   @default("register") // register, reset_password
  expiresAt   DateTime
  consumed    Boolean  @default(false)
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([email, consumed])
  @@index([email, otpCode])
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String
  deviceInfo  String?
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Debitur {
  id                   String               @id // no_rekening
  cif                  String
  nama                 String
  nik                  String
  tglLahir             DateTime
  umur                 String?
  alamat               String
  kota                 String
  telepon              String
  pekerjaan            String
  agama                String
  resiko               String               // Rendah/Sedang/Tinggi
  jenisMargin          String               // jenis akad pembiayaan
  rateMargin           Float
  jw                   Int                  // jangka waktu (bulan)
  tglAwal              DateTime
  tglJt                DateTime
  tglAngsuranTerakhir  DateTime?
  ao                   String
  aoId                 String?
  aoUser               User?                @relation("AoDebiturRelation", fields: [aoId], references: [id])
  plafon               Float
  bakiDebet            Float
  angsPrincipal        Float
  angsMargin           Float
  tPokok               Float                // tunggakan pokok
  frPokok              Int                  // frekuensi tunggakan pokok
  frhPokok             Int                  // hari tunggakan pokok
  tMargin              Float                // tunggakan margin
  frMargin             Int
  frhMargin            Int
  totalTunggakan       Float                // tPokok + tMargin
  fr                   Int                  // frekuensi gabungan
  frHari               Int                  // hari gabungan
  kol                  String               // Lancar, DPK, Kurang Lancar, Diragukan, Macet
  kolMurni             String               // kode numerik asli dari CBS (1-5)
  restruk              Int                  // jumlah kali direstrukturisasi
  rekTabungan          String?
  saldoTabungan        Float?
  jenisAgunan          String?
  nilaiJaminan         Float?
  spkNumber            String?
  latitude             Float?
  longitude            Float?
  statusDebitur        String               @default("Aktif") // Aktif, Lunas, TidakDitemukan
  lastSyncedAt         DateTime?
  lastSeenInImportAt   DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  kolHistory           DebiturKolHistory[]
  deskCalls            DeskCall[]
  jadwalPenagihan      JadwalPenagihan[]
  legalBerkas          LegalBerkas[]
  pembayaran           Pembayaran[]
  suratLegal           SuratLegal[]
  aoCollectionLogs     AoCollectionLog[]
  aoReminderEmailLogs  AoReminderEmailLog[]

  @@index([kol, bakiDebet])
  @@index([ao, statusDebitur])
  @@index([statusDebitur])
  @@index([tglJt])
  @@index([cif])
}

model DebiturKolHistory {
  id              String   @id @default(uuid())
  debiturId       String
  tanggalSnapshot DateTime
  bulanLabel      String
  kol             String
  bakiDebet       Float

  debitur         Debitur  @relation(fields: [debiturId], references: [id], onDelete: Cascade)

  @@index([debiturId, tanggalSnapshot])
}

model DeskCall {
  id                 String    @id @default(uuid())
  debiturId          String
  namaDebitur        String
  tanggal            DateTime
  waktu              String    // format HH:mm:ss
  petugasId          String
  kol                String    // snapshot
  jenisKontak        String    // Telepon, WhatsApp
  statusKontak       String    // Terhubung, Tersambung Tidak Diangkat, Tidak Diangkat, Nomor Ditolak, Sibuk, Tidak Aktif, Salah Nomor
  hasilKomunikasi    String?
  tindakLanjut       String?   // Janji Bayar, Negosiasi, Restrukturisasi, Eskalasi, Tidak Ada
  prioritas          String    // Kritis, Tinggi, Sedang, Rendah
  nominalJanji       Float?
  tanggalJanjiBayar  DateTime?
  bakiDebet          Float     // snapshot
  durasiPanggilan    String?   // durasi panggilan telepon (cth: "01:30" / "45 dtk")
  createdAt          DateTime  @default(now())

  debitur            Debitur   @relation(fields: [debiturId], references: [id], onDelete: Cascade)
  petugas            User      @relation(fields: [petugasId], references: [id], onDelete: Cascade)

  @@index([debiturId, tanggal])
  @@index([petugasId, tanggal])
  @@index([tanggalJanjiBayar])
  @@index([tanggal])
}

model JadwalPenagihan {
  id               String          @id @default(uuid())
  nomorJadwal      String          // format P3/2026/06/041
  tanggal          DateTime
  waktuMulai       String          // format HH:mm
  petugasId        String
  area             String
  prioritas        String          // Kritis, Tinggi, Sedang, Rendah
  debiturId        String
  namaDebitur      String
  kol              String          // snapshot
  bakiDebet        Float           // snapshot
  targetTagih      Float
  alamat           String
  jenisTagih       String
  metode           String
  status           String          @default("Terjadwal") // Terjadwal, Dalam Proses, Selesai, Batal, Lewat Jatuh Tempo
  nominalRealisasi Float           @default(0)
  catatan          String?
  hasil            String?
  checkInLat         Float?
  checkInLng         Float?
  checkInTime        DateTime?
  checkInAddress     String?
  tandaTanganDebitur String?
  tandaTanganNama    String?
  localRecordedAt    DateTime?
  isOfflineSync      Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  debitur          Debitur         @relation(fields: [debiturId], references: [id], onDelete: Cascade)
  petugas          User            @relation(fields: [petugasId], references: [id], onDelete: Cascade)
  fotos            PenagihanFoto[]

  @@index([debiturId, tanggal])
  @@index([petugasId, status])
  @@index([status, tanggal])
}

model PenagihanFoto {
  id         String   @id @default(uuid())
  jadwalId   String
  filePath   String
  latitude   Float?
  longitude  Float?
  gpsAddress String?
  uploadedAt DateTime @default(now())
  uploadedBy String

  jadwal     JadwalPenagihan @relation(fields: [jadwalId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
}

model LegalBerkas {
  id          String   @id // LF-001 format
  debiturId   String
  plafon      Float
  jenisAgunan String
  notaris     String
  noAkad      String
  lokasiArsip String
  status      String   // Lengkap, Proses, Kurang (auto-calculated)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  debitur     Debitur  @relation(fields: [debiturId], references: [id], onDelete: Cascade)
  checklists  LegalBerkasChecklist[]
  files       LegalFile[]

  @@index([debiturId])
  @@index([status])
}

model LegalBerkasChecklist {
  id            String    @id @default(uuid())
  legalBerkasId String
  kategori      String    // Identitas, Usaha, Agunan, Akad & Notarial
  itemName      String
  checked       Boolean   @default(false)
  checkedAt     DateTime?
  checkedBy     String?

  berkas        LegalBerkas @relation(fields: [legalBerkasId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [checkedBy], references: [id])
}

model LegalFile {
  id            String   @id @default(uuid())
  legalBerkasId String
  fileName      String
  filePath      String
  uploadedAt    DateTime @default(now())
  uploadedBy    String

  berkas        LegalBerkas @relation(fields: [legalBerkasId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
}

model SuratLegal {
  id             String    @id @default(uuid())
  nomorSurat     String    @unique
  jenisSurat     String    // SP1, SP2, Somasi 1, Somasi 2, Eksekusi Jaminan
  debiturId      String
  namaDebitur    String
  tanggalSurat   DateTime
  tglJatuhTempo  DateTime?
  hal            String
  totalTunggakan Float
  tPokok         Float
  tMargin        Float
  bakiDebet      Float
  status         String    @default("Diterbitkan") // Diterbitkan, Terkirim, Diterima, Selesai
  penerima       String?
  tglDiterima    DateTime?
  petugas        String
  catatan        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  debitur        Debitur   @relation(fields: [debiturId], references: [id], onDelete: Cascade)

  @@index([debiturId, tanggalSurat])
  @@index([status])
}

model Pembayaran {
  id            String    @id @default(uuid())
  debiturId     String
  nama          String
  tanggal       DateTime
  nominal       Float
  kol           String    // snapshot
  metode        String    // Transfer, Tunai
  petugas       String    // nama petugas pencatat
  keterangan    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime? @updatedAt
  updatedBy     String?
  importBatchId String?

  debitur       Debitur   @relation(fields: [debiturId], references: [id], onDelete: Cascade)

  @@index([debiturId, tanggal])
  @@index([tanggal])
  @@index([importBatchId])
}

model RbbTarget {
  id                   String   @id @default(uuid())
  periode              String   @unique // format YYYY-MM
  npfGross             Float    @default(5.0)
  collectionRate       Float    @default(70.0)
  recoveryRate         Float    @default(40.0)
  cureRate             Float    @default(20.0)
  ptpRate              Float    @default(40.0)
  promiseKept          Float    @default(60.0)
  coverageRatio        Float    @default(80.0)
  kunjunganPerPetugas  Float    @default(15.0)
  restrukSuccess       Float    @default(50.0)
  ppapCoverage         Float    @default(100.0)
  updatedBy            String
  updatedAt            DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  tableName String
  recordId  String
  oldValue  String?  // JSON string
  newValue  String?  // JSON string
  ipAddress String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tableName, recordId])
  @@index([createdAt])
  @@index([userId])
  @@index([action])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String
}

model ImportBatch {
  id                    String    @id @default(uuid())
  uploadedBy            String
  uploadedAt            DateTime  @default(now())
  fileName              String
  tanggalSnapshot       DateTime
  totalRowsParsed       Int
  totalUpdated          Int
  totalNewDetected      Int
  totalMissingDetected  Int
  status                String    // pending_review, applied, failed
  appliedAt             DateTime?
}

model ImportStagingRow {
  id         String   @id @default(uuid())
  batchId    String
  rawData    String   // JSON string of row
  rowStatus  String   // valid, error
  errorMessage String?
}

model PembayaranImportBatch {
  id            String   @id @default(uuid())
  uploadedBy    String
  uploadedAt    DateTime @default(now())
  fileName      String
  totalValid    Int
  totalAmbiguous Int
  totalFailed   Int
}

model AoCollectionLog {
  id                 String   @id @default(uuid())
  debiturId          String
  debitur            Debitur  @relation(fields: [debiturId], references: [id], onDelete: Cascade)
  namaDebitur        String
  aoId               String
  aoUser             User     @relation(fields: [aoId], references: [id])
  tanggal            DateTime @default(now())
  waktu              String?
  kol                String
  bakiDebet          Float
  jenisAktivitas     String   // Telepon, WhatsApp, Kunjungan Langsung, Email
  statusTindakLanjut String   // Sudah Dihubungi, Janji Bayar pada Tanggal Tertentu, Perlu Kunjungan Lapangan, Menunggu Konfirmasi, Selesai Ditindaklanjuti
  tanggalJanji       DateTime?
  catatan            String?
  createdAt          DateTime @default(now())
  createdBy          String
  createdByUser      User     @relation("CreatedByAoLog", fields: [createdBy], references: [id])

  @@index([debiturId, tanggal])
  @@index([aoId, tanggal])
}

model AoReminderEmailLog {
  id        String   @id @default(uuid())
  debiturId String
  debitur   Debitur  @relation(fields: [debiturId], references: [id], onDelete: Cascade)
  aoId      String
  aoUser    User     @relation(fields: [aoId], references: [id])
  periode   String   // format "YYYY-MM" (contoh: "2026-07")
  sentAt    DateTime @default(now())

  @@unique([debiturId, aoId, periode])
  @@index([debiturId])
  @@index([aoId])
}

